{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phyllo",
  "version": "0.1.0",
  "identifier": "com.phyllo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phyllo",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Music/Phyllo/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["phyllo"],
        "name": "Phyllo project",
        "description": "Phyllo project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-phyllo+json",
        "exportedType": {
          "identifier": "com.phyllo.project",
          "conformsTo": ["public.json"]
        }
      },
      {
        "ext": ["strudel"],
        "name": "Strudel pattern",
        "description": "Strudel pattern",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/x-strudel",
        "exportedType": {
          "identifier": "com.phyllo.strudel",
          "conformsTo": ["public.plain-text"]
        }
      }
    ]
  }
}
