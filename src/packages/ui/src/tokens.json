{
  "$description": "Phyllo design tokens. Source of truth for tokens.css. Theme-dependent values have dark and light entries; accents have a dark-mode shade (with its own ink) and a light-mode shade (white ink).",
  "font": {
    "ui": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "display": "'Source Serif 4', Georgia, serif",
    "mono": "'JetBrains Mono', ui-monospace, Menlo, monospace"
  },
  "type": {
    "display":    { "family": "display", "weight": 600, "size": 60, "lineHeight": 1.02, "letterSpacing": "-0.025em" },
    "title":      { "family": "display", "weight": 600, "size": 32, "lineHeight": 1.05, "letterSpacing": "-0.015em" },
    "wordmark":   { "family": "display", "weight": 600, "style": "italic", "size": 26, "lineHeight": 1 },
    "heading":    { "family": "ui", "weight": 700, "size": 18, "lineHeight": 1.3 },
    "subheading": { "family": "ui", "weight": 600, "size": 15, "lineHeight": 1.35 },
    "body":       { "family": "ui", "weight": 400, "size": 13, "lineHeight": 1.35 },
    "bodyLarge":  { "family": "ui", "weight": 400, "size": 16, "lineHeight": 1.45 },
    "small":      { "family": "ui", "weight": 400, "size": 12, "lineHeight": 1.35 },
    "label":      { "family": "ui", "weight": 600, "size": 11, "transform": "uppercase", "letterSpacing": "0.08em" },
    "legend":     { "family": "ui", "weight": 700, "size": 10.5, "transform": "uppercase", "letterSpacing": "0.1em" },
    "code":       { "family": "mono", "weight": 400, "size": 12, "lineHeight": 1.75 },
    "readout":    { "family": "mono", "weight": 500, "size": 18, "lineHeight": 1.1 }
  },
  "space": { "1": 4, "2": 6, "3": 8, "4": 10, "5": 12, "6": 16, "7": 20, "8": 24, "9": 32, "10": 40 },
  "radius": { "xs": 2, "sm": 6, "md": 8, "lg": 10, "xl": 14, "2xl": 18, "full": 9999 },
  "size": { "titlebarInset": 84, "trackHeaderWidth": 208, "laneHeight": 56, "libraryWidth": 248, "inspectorWidth": 320, "stripWidth": 124 },
  "color": {
    "bg":          { "dark": "#0F1210", "light": "#EEF0EA" },
    "chrome":      { "dark": "#141916", "light": "#F8F9F5" },
    "panel":       { "dark": "#191E1B", "light": "#FFFFFF" },
    "raised":      { "dark": "#252B27", "light": "#E9ECE5" },
    "sunken":      { "dark": "#0B0E0C", "light": "#E3E6DE" },
    "line":        { "dark": "#2C332E", "light": "#D5D9CF" },
    "lineSoft":    { "dark": "#232925", "light": "#E6E9E2" },
    "text":        { "dark": "#E9EEE8", "light": "#141815" },
    "muted":       { "dark": "#A3ADA5", "light": "#535D56" },
    "rec":         { "dark": "#FF6B57", "light": "#C63A27" },
    "recInk":      { "dark": "#1A0A07", "light": "#FFFFFF" },
    "star":        { "dark": "#F5C25B", "light": "#A86A00" },
    "switchOff":   { "dark": "#3A423C", "light": "#B9BFB5" },
    "stepOff":     { "dark": "#1E2420", "light": "#FFFFFF" },
    "stepBeat":    { "dark": "#262D28", "light": "#E9ECE5" },
    "grid":        { "dark": "rgba(233,238,232,0.045)", "light": "rgba(20,24,21,0.045)" },
    "gridStrong":  { "dark": "rgba(233,238,232,0.12)", "light": "rgba(20,24,21,0.14)" },
    "scrim":       { "dark": "rgba(8,10,9,0.62)", "light": "rgba(238,240,234,0.7)" },
    "codeString":  { "dark": "#F2C46B", "light": "#8A5000" },
    "codeNumber":  { "dark": "#8EC5FF", "light": "#1F5FBF" },
    "codeFunction":{ "dark": "#C9A7FF", "light": "#7A3FC4" },
    "codeComment": { "dark": "#808B83", "light": "#5F6862" },
    "legend":      { "dark": "#E7DDC4", "light": "#3B3529" },
    "plate":       { "dark": "#121614", "light": "#E2E5DC" },
    "knobSkirtA":  { "dark": "#4A504C", "light": "#555B57" },
    "knobSkirtB":  { "dark": "#121514", "light": "#1A1D1B" },
    "knobCapA":    { "dark": "#3C423E", "light": "#464B48" },
    "knobCapB":    { "dark": "#171A18", "light": "#1C1F1D" },
    "knobPointer": { "dark": "#F4EFE1", "light": "#FFFFFF" },
    "knobTick":    { "dark": "rgba(231,221,196,0.5)", "light": "rgba(59,53,41,0.5)" },
    "clipInk": "#10140F",
    "modulated": "#F5C25B",
    "solo": "#F5C25B"
  },
  "accent": {
    "green":  { "dark": "#8FE388", "darkInk": "#0E1A0D", "light": "#1F7A2E", "lightInk": "#FFFFFF", "default": true },
    "red":    { "dark": "#FF7A70", "darkInk": "#1F0806", "light": "#C0302B", "lightInk": "#FFFFFF" },
    "blue":   { "dark": "#7EB2FF", "darkInk": "#08142A", "light": "#1F5FCC", "lightInk": "#FFFFFF" },
    "purple": { "dark": "#B79CFF", "darkInk": "#160C2E", "light": "#6D3FD0", "lightInk": "#FFFFFF" },
    "orange": { "dark": "#FFAA5C", "darkInk": "#241102", "light": "#B04E00", "lightInk": "#FFFFFF" },
    "teal":   { "dark": "#5FD6CC", "darkInk": "#04201D", "light": "#0B7A72", "lightInk": "#FFFFFF" },
    "$derived": { "accentSoft": "accent at 14% (dark) / 10% (light)", "sel": "6% / 5%", "hl": "9% / 8%", "accentText": "accent (dark) / accent mixed 85% with black (light, 4.5:1 on panel, raised, soft, sel)" }
  },
  "track": ["#7FD98A", "#5ECFC8", "#8AB4FF", "#F5C25B", "#B9A2FF", "#F59AC7", "#FF9C7A"],
  "trackNames": ["green", "teal", "blue", "amber", "violet", "pink", "coral"],
  "shadow": {
    "btn":    { "dark": "inset 0 1px 0 rgba(255,255,255,0.08), 0 1px 2px rgba(0,0,0,0.55)", "light": "inset 0 1px 0 #FFFFFF, 0 1px 2px rgba(30,40,30,0.18)" },
    "key":    { "dark": "inset 0 1px 0 rgba(255,255,255,0.45), inset 0 -2px 0 rgba(0,0,0,0.22), 0 2px 4px rgba(0,0,0,0.5)", "light": "inset 0 1px 0 rgba(255,255,255,0.35), inset 0 -2px 0 rgba(0,0,0,0.18), 0 2px 4px rgba(30,40,30,0.25)" },
    "inset":  { "dark": "inset 0 2px 6px rgba(0,0,0,0.55)", "light": "inset 0 2px 5px rgba(30,40,30,0.14)" },
    "bevel":  { "dark": "inset 0 1px 0 rgba(255,255,255,0.05)", "light": "inset 0 1px 0 #FFFFFF" },
    "plate":  { "dark": "inset 0 2px 5px rgba(0,0,0,0.6), 0 1px 0 rgba(255,255,255,0.04)", "light": "inset 0 2px 4px rgba(30,40,30,0.16), 0 1px 0 #FFFFFF" },
    "card":   { "dark": "0 18px 40px rgba(0,0,0,0.45)", "light": "0 14px 32px rgba(30,45,30,0.12)" },
    "dialog": { "dark": "0 24px 60px rgba(0,0,0,0.55)", "light": "0 24px 60px rgba(30,45,30,0.18)" }
  },
  "gradient": {
    "panel":  { "dark": "linear-gradient(180deg, #1F2421 0%, #161A18 100%)", "light": "linear-gradient(180deg, #FCFCFA 0%, #ECEEE8 100%)" },
    "button": { "dark": "linear-gradient(180deg, #2D3430 0%, #1E2421 100%)", "light": "linear-gradient(180deg, #FFFFFF 0%, #E5E8E0 100%)" },
    "wood": "linear-gradient(90deg, rgba(0,0,0,0.38), rgba(255,255,255,0.07) 45%, rgba(0,0,0,0.42)), repeating-linear-gradient(90deg, #5B3A22 0px, #6E472A 1px, #57361F 2px, #7A4F2F 3.5px, #4C2F1B 4.5px, #5B3A22 5.5px)"
  },
  "motion": { "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)", "fast": 90, "base": 160 }
}
